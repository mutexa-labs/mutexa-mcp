{
  "name": "@mutexa/mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for liquidation exposure: Hyperliquid markets and positions, liquidation prices, slice and loan ladders, Aave V3 reserves, linkability scores, tracker views and liquidation maps, from public data with no API key.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/mutexa-mcp.git"
  },
  "homepage": "https://github.com/mutexa-labs/mutexa-mcp#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/mutexa-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hyperliquid",
    "aave",
    "liquidation",
    "agents",
    "mutexa"
  ],
  "bin": {
    "mutexa-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test,scripts,examples}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts,examples}/**/*.ts\"",
    "test": "vitest run",
    "record": "tsx scripts/record.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mutexa/ladder": "github:mutexa-labs/liquidation-ladder#v0.1.0",
    "@mutexa/linkability": "github:mutexa-labs/linkability#v0.1.0",
    "@mutexa/liq-math": "github:mutexa-labs/liq-math#v0.1.0",
    "@mutexa/liquidation-map": "github:mutexa-labs/liquidation-map#v0.1.0",
    "@mutexa/tracker-view": "github:mutexa-labs/tracker-view#v0.1.0",
    "@mutexa/venue-adapters": "github:mutexa-labs/venue-adapters#v0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
